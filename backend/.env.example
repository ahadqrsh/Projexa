# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
API_VERSION=v1
APP_NAME=Projexa

# ─── URLs ──────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Database ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/ai-project-mentor
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/ai-project-mentor-test

# ─── JWT (generate with: openssl rand -hex 32) ─────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_64_char_random_hex_string_aaaaaaaaaaaaaaaaaaaaaaaa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_DIFFERENT_64_char_random_hex_string_bbbbbbbbbbbb
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_to_another_64_char_random_hex_string_cccccccccccccccccc

# ─── Password & Tokens ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

# ─── AI Provider ───────────────────────────────────────────────────────
# gemini | openai | mock   (mock = deterministic fixtures, zero API cost)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=8192
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_QUEUE_CONCURRENCY=3

# ─── Quotas ────────────────────────────────────────────────────────────
DEFAULT_AI_CREDITS=200
CREDIT_RESET_DAYS=30

# ─── Cloudinary ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai-project-mentor

# ─── Uploads ───────────────────────────────────────────────────────────
MAX_AVATAR_SIZE_MB=2
MAX_COVER_SIZE_MB=3
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── Email (leave SMTP_HOST empty to log emails to console instead) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Projexa
EMAIL_FROM_ADDRESS=noreply@projexa.app

# ─── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10
GENERATION_RATE_LIMIT_MAX=10
EXPORT_RATE_LIMIT_MAX=15

# ─── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_TO_FILE=false

# ─── Jobs ──────────────────────────────────────────────────────────────
ENABLE_CRON=true
PURGE_DELETED_AFTER_DAYS=30
STUCK_JOB_TIMEOUT_MINUTES=5
REPORT_TTL_DAYS=30
